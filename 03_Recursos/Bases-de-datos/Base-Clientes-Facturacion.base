filters:
  and:
    - file.inFolder("02_Areas/Fotografia-Profesional/Clientes")

formulas:
  pendiente_cobro: "presupuesto - cobrado"
  estado_icon: 'if(estado == "Cobrado", "✅", if(estado == "Facturado", "🧾", if(estado == "Confirmado", "📅", if(estado == "Presupuestado", "✉️", "❔"))))'
  dias_hasta_sesion: 'if(fecha_sesion, (date(fecha_sesion) - today()).days, "")'

properties:
  tipo_sesion:
    displayName: "Tipo de sesión"
  presupuesto:
    displayName: "Presupuesto (€)"
  facturado:
    displayName: "Facturado (€)"
  cobrado:
    displayName: "Cobrado (€)"
  formula.pendiente_cobro:
    displayName: "Pendiente de cobro (€)"
  formula.estado_icon:
    displayName: ""
  fecha_sesion:
    displayName: "Fecha de sesión"

views:
  - type: cards
    name: "Clientes"
    order:
      - file.name
      - tipo_sesion
      - formula.estado_icon
      - fecha_sesion

  - type: table
    name: "Facturación"
    order:
      - file.name
      - estado
      - presupuesto
      - facturado
      - cobrado
      - formula.pendiente_cobro
    summaries:
      presupuesto: Sum
      facturado: Sum
      cobrado: Sum
      formula.pendiente_cobro: Sum

  - type: table
    name: "Pendientes de cobro"
    filters:
      and:
        - 'formula.pendiente_cobro > 0'
    order:
      - file.name
      - estado
      - formula.pendiente_cobro
      - fecha_sesion
    groupBy:
      property: estado
      direction: ASC
